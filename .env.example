# Local app settings: leave these unchanged.
PORT=5191
HOST=127.0.0.1
VITE_PORT=5190
VITE_API_PORT=5191
DB_CLIENT=postgres

# Supabase PostgreSQL connection (SERVER ONLY, never prefix with VITE_).
# The current database is already migrated. Do not run the import again.
# Copy your project's Connect > Session pooler URI and replace its password.
# Prefer replacing this entire dummy URL with the actual dashboard URI.
# URL-encode special characters in the password. Keep TLS verification enabled.
DATABASE_URL="postgresql://postgres.REPLACE_PROJECT_REF:REPLACE_URL_ENCODED_DATABASE_PASSWORD@REPLACE_SESSION_POOLER_HOST:5432/postgres?sslmode=verify-full"

# Optional: path to the Supabase root certificate if certificate verification
# requires it. Download it from the project's Database settings.
# PGSSLROOTCERT="/absolute/path/to/prod-supabase.cer"

# Optional existing SQLite directory; leave unset to use ./data/kesari.sqlite.
# DATA_DIR=/absolute/path/to/data
